<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Maque" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#1976D2</item>
        <item name="android:navigationBarColor">#15181C</item>
        <item name="android:statusBarColor">#15181C</item>
    </style>

    <style name="Theme.Maque.Game" parent="android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>
</resources>
