# build output
/build/
/build-*/
compile_commands.json

# 配置/构建日志（tools/win/build.ps1 与手工 cmake 的落盘输出）
/configure-*.log
/build-*.log
# 临时重定向的构建输出（调试时 `cmake --build > out.txt` 之类的产物）
/*-out.txt
/*-out.log
/out.txt
# 临时重定向的 ctest 输出（`ctest > ctest-xxx.txt`；曾误落进工作树）
/ctest-*.txt
/ctest-*.log

# wgpu-native binary SDK (headers are committed; binaries are not)
third_party/wgpu-native/lib/*.so
third_party/wgpu-native/lib/*.a
third_party/wgpu-native/lib/*.dll
third_party/wgpu-native/lib/*.lib
third_party/wgpu-native/lib/*.pdb

# 注意：modules/core/data/generated/ **入库**（生成的公开接口是交付物，docs/21）
# CTest 在源码树根运行时的临时产物（构建产物不入库）
Testing/
.maque/

# Windows 第三方原生依赖（下载/构建产物，不入库）
/.deps/

# Android template local dependencies and build output
/android/.gradle/
/android/.idea/
/android/.deps/
/android/build/
/android/local.properties
/android/app/build/
/android/app/.cxx/
/android/app/src/main/jniLibs/*/*.so

# Khronos 模型批量迁移：派生资产（mesh.json / 贴图）与 1280x720 原图体积大，不入库；
# 由 tools/migrate_gltf_models.py 从 .deps/gltf-assets 重新生成（见 scenes/khronos/README.md）。
/scenes/khronos/*/assets/
/scenes/khronos/*/textures/
/scenes/khronos/*/preview.png

# Python 字节码缓存
__pycache__/

# 本地调试/渲染实验临时目录（AGENTS：单测临时目录回退目标）
/maque-test-tmp/

# khronos-bin：runtime 直读 .glb 对照资产（经 Git LFS 提交）
